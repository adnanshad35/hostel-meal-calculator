{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "hostel-meal-calculator-1035",
          "appId": "1:115727062396:android:187755a46298d9b377c0f9",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "hostel-meal-calculator-1035",
          "configurations": {
            "android": "1:115727062396:android:187755a46298d9b377c0f9",
            "web": "1:115727062396:web:e4dd1b298dd80f5977c0f9"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "public": "build/hosting",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/app/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/*.@(png|jpg|svg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ],
      "site": "hostelmate"
    },
    {
      "site": "hostel-meal-calculator-1035",
      "public": "website",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "**",
          "destination": "https://hostelmate.web.app",
          "type": 302
        }
      ]
    }
  ]
}
