rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId))
            .data.memberIds;
    }

    function isGroupAdmin(groupId) {
      return isSignedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId))
            .data.admins;
    }

    // True for anyone in the group's member list, including members
    // who do not use the app.
    function isRegisteredMember(groupId, memberId) {
      return exists(
        /databases/$(database)/documents/groups/$(groupId)/members/$(memberId)
      );
    }

    // A user's own groupId and role must agree with the group itself,
    // so nobody can place themselves in a group or make themselves
    // an admin by editing their profile.
    function ownGroupFieldsAreValid() {
      let groupId = request.resource.data.get('groupId', null);
      let role = request.resource.data.get('role', 'member');

      return (groupId == null && role == 'member')
        || (
          groupId is string
          && request.auth.uid in
            getAfter(/databases/$(database)/documents/groups/$(groupId))
              .data.memberIds
          && (
            role == 'member'
            || (
              role == 'admin'
              && request.auth.uid in
                getAfter(/databases/$(database)/documents/groups/$(groupId))
                  .data.admins
            )
          )
        );
    }

    match /users/{userId} {
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && ownGroupFieldsAreValid();

      allow update: if isSignedIn() && (
        (
          request.auth.uid == userId
          && ownGroupFieldsAreValid()
        )
        ||
        (
          resource.data.groupId != null
          && isGroupAdmin(resource.data.groupId)
          && (
            (
              request.resource.data.groupId
                == resource.data.groupId
              && request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'role',
                  'updatedAt'
                ])
              && request.resource.data.role in [
                'admin',
                'member'
              ]
            )
            ||
            (
              request.resource.data.groupId == null
              && request.resource.data.role == 'member'
              && request.resource.data.previousGroupId
                == resource.data.groupId
              && request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'groupId',
                  'role',
                  'previousGroupId',
                  'updatedAt'
                ])
            )
          )
        )
      );

      allow read: if isSignedIn() && (
        request.auth.uid == userId
        ||
        (
          resource.data.groupId != null
          && resource.data.groupId ==
            get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.groupId
        )
      );

      allow delete: if false;
    }

    match /groups/{groupId} {
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.admins
        && request.auth.uid in request.resource.data.memberIds;

      allow read: if isSignedIn()
        && request.auth.uid in resource.data.memberIds;

      allow update: if isSignedIn() && (
        (
          isGroupAdmin(groupId)
          && request.resource.data.admins.size() > 0
        )
        ||
        (
          // Joining: the same batch must save the group's invitation
          // code on the joining user's profile, which proves they
          // know it, and the invitation must still be active.
          !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(['memberIds'])
          && request.resource.data.memberIds.size()
            == resource.data.memberIds.size() + 1
          && getAfter(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.get('joinCode', null) == resource.data.inviteCode
          && get(
              /databases/$(database)/documents/invites/$(resource.data.inviteCode)
            ).data.active == true
        )
        ||
        (
          request.auth.uid in resource.data.memberIds
          && !(request.auth.uid in request.resource.data.memberIds)
          && request.resource.data.memberIds.size()
            == resource.data.memberIds.size() - 1
          && request.resource.data.admins
            == resource.data.admins
          && request.resource.data.name
            == resource.data.name
          && request.resource.data.inviteCode
            == resource.data.inviteCode
          && request.resource.data.createdBy
            == resource.data.createdBy
        )
      );

      allow delete: if false;

      match /meals/{mealId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && (
            request.resource.data.userId in
              get(/databases/$(database)/documents/groups/$(groupId))
                .data.memberIds
            || (
              isGroupAdmin(groupId)
              && isRegisteredMember(
                groupId,
                request.resource.data.userId
              )
            )
          )
          && (
            request.resource.data.userId == request.auth.uid
            || isGroupAdmin(groupId)
          );

        allow update: if isGroupMember(groupId)
          && request.resource.data.userId
            == resource.data.userId
          && (
            resource.data.userId == request.auth.uid
            || isGroupAdmin(groupId)
          );

        allow delete: if isGroupAdmin(groupId)
          || (
            isGroupMember(groupId)
            && resource.data.userId == request.auth.uid
          );
      }

      match /expenses/{expenseId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && (
            request.resource.data.paidById in
              get(/databases/$(database)/documents/groups/$(groupId))
                .data.memberIds
            || (
              isGroupAdmin(groupId)
              && isRegisteredMember(
                groupId,
                request.resource.data.paidById
              )
            )
          )
          && (
            request.resource.data.paidById == request.auth.uid
            || isGroupAdmin(groupId)
          )
          && request.resource.data.enteredBy
            == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.paidByName is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.date is timestamp;

        allow update: if isGroupMember(groupId)
          && request.resource.data.paidById
            == resource.data.paidById
          && (
            resource.data.paidById == request.auth.uid
            || isGroupAdmin(groupId)
          )
          && request.resource.data.name is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.date is timestamp
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'amount',
              'date',
              'updatedBy',
              'updatedAt'
            ]);

        allow delete: if isSignedIn()
  && get(
    /databases/$(database)/documents/groups/$(groupId)
  ).data.admins.hasAny([request.auth.uid]);
      }

      match /monthlySettings/{monthKey} {
  allow read: if isGroupMember(groupId);

  allow create, update: if isGroupAdmin(groupId)
    && request.resource.data.minimumMeals is number
    && request.resource.data.minimumMeals >= 0
    && request.resource.data.shopDue is number
    && request.resource.data.shopDue >= 0
    && request.resource.data.monthKey == monthKey;

  allow delete: if isGroupAdmin(groupId);
}

      match /members/{memberId} {
        // An app user's entry: stored under their uid and active
        // exactly while they are in the group.
        function isAppUserEntry() {
          return request.resource.data.isAppUser == true
            && request.resource.data.userId == memberId
            && request.resource.data.name is string
            && request.resource.data.active == (
              memberId in
                get(/databases/$(database)/documents/groups/$(groupId))
                  .data.memberIds
            );
        }

        allow read: if isGroupMember(groupId);

        // Admins manage every member, including non-app members.
        // Any member may keep app user entries in sync with the group,
        // but may only rename their own.
        allow create: if (
            isGroupAdmin(groupId)
            && request.resource.data.name is string
            && request.resource.data.active is bool
          )
          || (isGroupMember(groupId) && isAppUserEntry());

        allow update: if (
            isGroupAdmin(groupId)
            && request.resource.data.name is string
            && request.resource.data.active is bool
          )
          || (
            isGroupMember(groupId)
            && isAppUserEntry()
            && (
              memberId == request.auth.uid
              || request.resource.data.name == resource.data.name
            )
          );

        // Members are deactivated, never deleted.
        allow delete: if false;
      }
    }

    match /invites/{inviteCode} {
      // An invitation can be looked up by its code but never listed.
      allow get: if isSignedIn();
      allow list: if false;

      // Created together with its group, by the group's creator.
      allow create: if isSignedIn()
        && request.resource.data.createdBy
          == request.auth.uid
        && request.resource.data.active is bool
        && getAfter(
            /databases/$(database)/documents/groups/$(request.resource.data.groupId)
          ).data.inviteCode == inviteCode
        && getAfter(
            /databases/$(database)/documents/groups/$(request.resource.data.groupId)
          ).data.createdBy == request.auth.uid;

      // Admins can switch joining off and on again.
      allow update: if isGroupAdmin(resource.data.groupId)
        && request.resource.data.active is bool
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['active', 'updatedAt']);

      allow delete: if false;
    }
  }
}
