rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId))
            .data.memberIds;
    }

    function isGroupAdmin(groupId) {
      return isSignedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId))
            .data.admins;
    }

    // The app-wide administrator: read-only access to every account
    // and hostel, and the only sender of app notices.
    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'adnanshad1035@gmail.com';
    }

    // A hostel can be changed only while its paid or voucher period
    // is running. Afterwards it is read-only.
    function isHostelActive(groupId) {
      let path = /databases/$(database)/documents/subscriptions/$(groupId);

      return exists(path)
        && get(path).data.get('periodStart', null) is timestamp
        && request.time < get(path).data.periodStart
          + duration.value(get(path).data.days, 'd')
        && get(path).data.get('editingDisabled', false) != true
        && get(path).data.get('accessDisabled', false) != true;
    }

    // False while the super admin has suspended the hostel. Its
    // records then cannot be read by its members either.
    function isHostelOpen(groupId) {
      let path = /databases/$(database)/documents/subscriptions/$(groupId);

      return !exists(path)
        || get(path).data.get('accessDisabled', false) != true;
    }

    // Members may read a hostel's records unless it is suspended.
    function canReadHostel(groupId) {
      return isGroupMember(groupId) && isHostelOpen(groupId);
    }

    // A hostel's admins can keep entering or changing meals and
    // expenses to themselves, in its settings. [what] is
    // 'membersCanAddMeals', 'membersCanAddExpenses' or 'membersCanEdit';
    // each is allowed unless switched off.
    function membersMay(groupId, what) {
      return isGroupAdmin(groupId)
        || get(/databases/$(database)/documents/groups/$(groupId))
          .data.get('settings', {}).get(what, true) != false;
    }

    // ─── Month lock ───
    // A month's meals and expenses can be entered and changed until
    // the 7th of the next month, by everyone, admins included. Months
    // are counted as year * 12 + month, in Bangladesh time (UTC+6),
    // the time the app's dates are entered in.
    function localNow() {
      return request.time + duration.value(6, 'h');
    }

    function currentMonthIndex() {
      return localNow().year() * 12 + localNow().month();
    }

    // The earliest month still open: last month until the 7th, then
    // only this month.
    function isOpenMonth(index) {
      return index >= (
        localNow().day() <= 7 ? currentMonthIndex() - 1 : currentMonthIndex()
      );
    }

    // Months before last month keep only their summary; their records
    // are cleared once it is saved, so an admin may delete them.
    function isSummaryOnlyMonth(index) {
      return index < currentMonthIndex() - 1;
    }

    // A meal's month, from its `dateKey` (YYYY-MM-DD).
    function mealMonth(data) {
      let parts = data.dateKey.split('-');
      return int(parts[0]) * 12 + int(parts[1]);
    }

    // An expense's month, from its `date`, saved as the local day.
    function expenseMonth(data) {
      let local = data.date + duration.value(6, 'h');
      return local.year() * 12 + local.month();
    }

    // True for anyone in the group's member list, including members
    // who do not use the app.
    function isRegisteredMember(groupId, memberId) {
      return exists(
        /databases/$(database)/documents/groups/$(groupId)/members/$(memberId)
      );
    }

    // A user's own groupId and role must agree with the group itself,
    // so nobody can place themselves in a group or make themselves
    // an admin by editing their profile.
    function ownGroupFieldsAreValid() {
      let groupId = request.resource.data.get('groupId', null);
      let role = request.resource.data.get('role', 'member');

      return (groupId == null && role == 'member')
        || (
          groupId is string
          && request.auth.uid in
            getAfter(/databases/$(database)/documents/groups/$(groupId))
              .data.memberIds
          && (
            role == 'member'
            || (
              role == 'admin'
              && request.auth.uid in
                getAfter(/databases/$(database)/documents/groups/$(groupId))
                  .data.admins
            )
          )
        );
    }

    match /users/{userId} {
      // A profile is created at sign-up, before the email is verified.
      // It cannot place the user in a group: joining one requires a
      // verified email.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && ownGroupFieldsAreValid();

      allow update: if isSignedIn() && (
        (
          request.auth.uid == userId
          && ownGroupFieldsAreValid()
        )
        ||
        (
          // Deleting a hostel: the super admin takes its users out of
          // it, and can change nothing else on a profile.
          isSuperAdmin()
          && request.resource.data.groupId == null
          && request.resource.data.role == 'member'
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'groupId',
              'role',
              'previousGroupId',
              'updatedAt'
            ])
        )
        ||
        (
          resource.data.groupId != null
          && isGroupAdmin(resource.data.groupId)
          && (
            (
              request.resource.data.groupId
                == resource.data.groupId
              && request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'role',
                  'updatedAt'
                ])
              && request.resource.data.role in [
                'admin',
                'member'
              ]
            )
            ||
            (
              request.resource.data.groupId == null
              && request.resource.data.role == 'member'
              && request.resource.data.previousGroupId
                == resource.data.groupId
              && request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'groupId',
                  'role',
                  'previousGroupId',
                  'updatedAt'
                ])
            )
          )
        )
      );

      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isSuperAdmin()
        ||
        (
          resource.data.groupId != null
          && resource.data.groupId ==
            get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.groupId
        )
      );

      allow delete: if false;
    }

    match /groups/{groupId} {
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.admins
        && request.auth.uid in request.resource.data.memberIds;

      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds
        || isSuperAdmin()
      );

      allow update: if isSignedIn() && (
        (
          isGroupAdmin(groupId)
          && request.resource.data.admins.size() > 0
        )
        ||
        (
          // Joining: the same batch must save the group's invitation
          // code on the joining user's profile, which proves they
          // know it, and the invitation must still be active.
          !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(['memberIds'])
          && request.resource.data.memberIds.size()
            == resource.data.memberIds.size() + 1
          && getAfter(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.get('joinCode', null) == resource.data.inviteCode
          && get(
              /databases/$(database)/documents/invites/$(resource.data.inviteCode)
            ).data.active == true
        )
        ||
        (
          request.auth.uid in resource.data.memberIds
          && !(request.auth.uid in request.resource.data.memberIds)
          && request.resource.data.memberIds.size()
            == resource.data.memberIds.size() - 1
          && request.resource.data.admins
            == resource.data.admins
          && request.resource.data.name
            == resource.data.name
          && request.resource.data.inviteCode
            == resource.data.inviteCode
          && request.resource.data.createdBy
            == resource.data.createdBy
        )
      );

      // An admin who is the only app user left may delete the hostel,
      // so they are never stuck in one they cannot leave. The super
      // admin may delete any hostel.
      allow delete: if isSuperAdmin() || (
        isSignedIn()
        && request.auth.uid in resource.data.admins
        && resource.data.memberIds.size() == 1
        && request.auth.uid in resource.data.memberIds
      );

      // Everything stored inside a hostel, whatever it is: the super
      // admin may read and delete it, to remove a hostel completely.
      match /{records=**} {
        allow read, delete: if isSuperAdmin();
      }

      match /meals/{mealId} {
        allow read: if canReadHostel(groupId);

        allow create: if isGroupMember(groupId)
          && isHostelActive(groupId)
          && membersMay(groupId, 'membersCanAddMeals')
          && (
            request.resource.data.userId in
              get(/databases/$(database)/documents/groups/$(groupId))
                .data.memberIds
            || (
              isGroupAdmin(groupId)
              && isRegisteredMember(
                groupId,
                request.resource.data.userId
              )
            )
          )
          && (
            request.resource.data.userId == request.auth.uid
            || isGroupAdmin(groupId)
          )
          && isOpenMonth(mealMonth(request.resource.data));

        allow update: if isGroupMember(groupId)
          && isHostelActive(groupId)
          && membersMay(groupId, 'membersCanAddMeals')
          && membersMay(groupId, 'membersCanEdit')
          && request.resource.data.userId
            == resource.data.userId
          && request.resource.data.dateKey
            == resource.data.dateKey
          && (
            resource.data.userId == request.auth.uid
            || isGroupAdmin(groupId)
          )
          && isOpenMonth(mealMonth(resource.data));

        allow delete: if isHostelActive(groupId) && (
          (
            isOpenMonth(mealMonth(resource.data))
            && (
              isGroupAdmin(groupId)
              || (
                isGroupMember(groupId)
                && membersMay(groupId, 'membersCanAddMeals')
                && membersMay(groupId, 'membersCanEdit')
                && resource.data.userId == request.auth.uid
              )
            )
          )
          || (
            isGroupAdmin(groupId)
            && (
              isSummaryOnlyMonth(mealMonth(resource.data))
            )
          )
        );
      }

      // What to count for a member on days without a meal entry.
      // Members set their own plan; admins can set anyone's.
      match /mealPlans/{memberId} {
        allow read: if canReadHostel(groupId);

        allow create, update: if isGroupMember(groupId)
          && isHostelActive(groupId)
          && membersMay(groupId, 'membersCanAddMeals')
          && request.resource.data.memberId == memberId
          && request.resource.data.memberName is string
          && request.resource.data.rules is list
          && request.resource.data.rules.size() <= 200
          && (
            memberId == request.auth.uid
            || (
              isGroupAdmin(groupId)
              && isRegisteredMember(groupId, memberId)
            )
          );

        allow delete: if isGroupAdmin(groupId)
          && isHostelActive(groupId);
      }

      match /expenses/{expenseId} {
        allow read: if canReadHostel(groupId);

        allow create: if isGroupMember(groupId)
          && isHostelActive(groupId)
          && membersMay(groupId, 'membersCanAddExpenses')
          && (
            request.resource.data.paidById in
              get(/databases/$(database)/documents/groups/$(groupId))
                .data.memberIds
            || (
              isGroupAdmin(groupId)
              && isRegisteredMember(
                groupId,
                request.resource.data.paidById
              )
            )
          )
          && (
            request.resource.data.paidById == request.auth.uid
            || isGroupAdmin(groupId)
          )
          && request.resource.data.enteredBy
            == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.paidByName is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.date is timestamp
          && isOpenMonth(expenseMonth(request.resource.data));

        allow update: if isGroupMember(groupId)
          && isHostelActive(groupId)
          && membersMay(groupId, 'membersCanAddExpenses')
          && membersMay(groupId, 'membersCanEdit')
          && request.resource.data.paidById
            == resource.data.paidById
          && (
            resource.data.paidById == request.auth.uid
            || isGroupAdmin(groupId)
          )
          && request.resource.data.name is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.date is timestamp
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'amount',
              'date',
              'description',
              'updatedBy',
              'updatedAt'
            ])
          && request.resource.data.get('description', '') is string
          && request.resource.data.get('description', '').size() <= 600
          // Neither the month it was in nor the one it moves to may
          // be closed.
          && isOpenMonth(expenseMonth(resource.data))
          && isOpenMonth(expenseMonth(request.resource.data));

        allow delete: if isGroupAdmin(groupId)
          && isHostelActive(groupId)
          && (
            // An expense without a date belongs to no month.
            !(resource.data.get('date', null) is timestamp)
            || isOpenMonth(expenseMonth(resource.data))
            || isSummaryOnlyMonth(expenseMonth(resource.data))
          );
      }

      match /monthlySettings/{monthKey} {
        allow read: if canReadHostel(groupId);

        allow create, update: if isGroupAdmin(groupId)
          && isHostelActive(groupId)
          && request.resource.data.minimumMeals is number
          && request.resource.data.minimumMeals >= 0
          && request.resource.data.shopDue is number
          && request.resource.data.shopDue >= 0
          && request.resource.data.monthKey == monthKey;

        allow delete: if isGroupAdmin(groupId)
          && isHostelActive(groupId);
      }

      match /members/{memberId} {
        // An app user's entry: stored under their uid and active
        // exactly while they are in the group.
        function isAppUserEntry() {
          return request.resource.data.isAppUser == true
            && request.resource.data.userId == memberId
            && request.resource.data.name is string
            && request.resource.data.active == (
              memberId in
                get(/databases/$(database)/documents/groups/$(groupId))
                  .data.memberIds
            );
        }

        allow read: if isGroupMember(groupId);

        // Admins manage every member, including non-app members.
        // Any member may keep app user entries in sync with the group,
        // but may only rename their own.
        allow create: if (
            isGroupAdmin(groupId)
            && request.resource.data.name is string
            && request.resource.data.active is bool
          )
          || (isGroupMember(groupId) && isAppUserEntry());

        allow update: if (
            isGroupAdmin(groupId)
            && request.resource.data.name is string
            && request.resource.data.active is bool
          )
          || (
            isGroupMember(groupId)
            && isAppUserEntry()
            && (
              memberId == request.auth.uid
              || request.resource.data.name == resource.data.name
            )
          );

        // App users are deactivated, never deleted. An admin may delete
        // a member who does not use the app.
        allow delete: if isGroupAdmin(groupId)
          && resource.data.get('isAppUser', false) != true;
      }

      // The hostel's history: who changed which meal, expense, month
      // figure or member. Any member may add a record of their own
      // change, stamped with the server's time, and every member may
      // read them all. No one, not even an admin, may change or delete
      // one; only the super admin removes them, with the whole hostel.
      match /activity/{activityId} {
        allow read: if canReadHostel(groupId);

        // The super admin records activation they add or change.
        allow create: if (isGroupMember(groupId) || isSuperAdmin())
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.kind is string
          && request.resource.data.actorName is string
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 400
          && request.resource.data.keys().hasOnly([
            'kind',
            'actorId',
            'actorName',
            'memberId',
            'memberName',
            'subject',
            'day',
            'details',
            'createdAt'
          ]);

        allow update, delete: if false;
      }

      // In-app notifications inside the hostel: activity recorded by
      // any member, and announcements written by admins.
      match /notifications/{notificationId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 600
          && (
            request.resource.data.type in ['expense', 'mealPlan']
            || (
              request.resource.data.type == 'announcement'
              && isGroupAdmin(groupId)
            )
          );

        allow update: if false;
        allow delete: if isGroupAdmin(groupId);
      }
    }

    // How long each hostel may be used.
    match /subscriptions/{groupId} {
      // A hostel admin may activate or extend their hostel with a
      // voucher that is switched on and that this hostel has not used
      // before. The period must be exactly what the voucher gives:
      // added to a running period, or started now.
      function redeemsVoucher() {
        let code = request.resource.data.voucherCode;
        let voucher =
          get(/databases/$(database)/documents/vouchers/$(code)).data;
        let redemption =
          /databases/$(database)/documents/vouchers/$(code)/redemptions/$(groupId);
        let stillActive = resource != null
          && resource.data.get('periodStart', null) is timestamp
          && request.time < resource.data.periodStart
            + duration.value(resource.data.days, 'd');

        return isGroupAdmin(groupId)
          && voucher.active == true
          && voucher.days > 0
          && !exists(redemption)
          && existsAfter(redemption)
          // Only the super admin can change these switches.
          && request.resource.data.get('editingDisabled', false)
            == (resource == null
              ? false
              : resource.data.get('editingDisabled', false))
          && request.resource.data.get('accessDisabled', false)
            == (resource == null
              ? false
              : resource.data.get('accessDisabled', false))
          && (
            stillActive
              ? (
                request.resource.data.periodStart
                  == resource.data.periodStart
                && request.resource.data.days
                  == resource.data.days + voucher.days
              )
              : (
                request.resource.data.periodStart == request.time
                && request.resource.data.days == voucher.days
              )
          );
      }

      allow read: if isGroupMember(groupId) || isSuperAdmin();
      allow create, update: if isSuperAdmin() || redeemsVoucher();
      allow delete: if isSuperAdmin();
    }

    // Voucher codes. Anyone who knows a code can look it up, but
    // codes can never be listed.
    match /vouchers/{code} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if isSuperAdmin();

      // One record per hostel that used the voucher, written together
      // with the subscription change it belongs to.
      match /redemptions/{groupId} {
        allow read: if isSuperAdmin();

        allow create: if isGroupAdmin(groupId)
          && request.resource.data.redeemedBy == request.auth.uid
          && getAfter(
              /databases/$(database)/documents/subscriptions/$(groupId)
            ).data.voucherCode == code;

        allow update, delete: if isSuperAdmin();
      }
    }

    // bKash payments reported by hostel admins. The transaction ID is
    // the document id, so one payment cannot be reported twice.
    match /payments/{trxId} {
      allow read: if isSuperAdmin()
        || (isSignedIn()
          && resource.data.submittedBy == request.auth.uid)
        || isGroupAdmin(resource.data.groupId);

      allow create: if isGroupAdmin(request.resource.data.groupId)
        && request.resource.data.trxId == trxId
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;

      allow update, delete: if isSuperAdmin();
    }

    // App-wide settings, such as where to send payments.
    match /config/{documentId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // App notices from the developer to every user.
    match /announcements/{announcementId} {
      allow read: if isSignedIn();

      allow create, update, delete: if isSuperAdmin();
    }

    // Ideas users send to the developer from the app. Anyone signed
    // in can send one in their own name; only the super admin reads
    // them.
    match /featureRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000;

      allow read, delete: if isSuperAdmin();
      allow update: if false;
    }

    match /invites/{inviteCode} {
      // An invitation can be looked up by its code but never listed.
      allow get: if isSignedIn();
      allow list: if false;

      // Created together with its group, by the group's creator.
      allow create: if isSignedIn()
        && request.resource.data.createdBy
          == request.auth.uid
        && request.resource.data.active is bool
        && getAfter(
            /databases/$(database)/documents/groups/$(request.resource.data.groupId)
          ).data.inviteCode == inviteCode
        && getAfter(
            /databases/$(database)/documents/groups/$(request.resource.data.groupId)
          ).data.createdBy == request.auth.uid;

      // Admins can switch joining off and on again. The super admin
      // switches it off when deleting a hostel.
      allow update: if (isGroupAdmin(resource.data.groupId) || isSuperAdmin())
        && request.resource.data.active is bool
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['active', 'updatedAt']);

      allow delete: if false;
    }
  }
}
