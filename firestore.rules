rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId))
            .data.memberIds;
    }

    function isGroupAdmin(groupId) {
      return isSignedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId))
            .data.admins;
    }

    match /users/{userId} {
      allow create, update: if isSignedIn()
        && request.auth.uid == userId;

      allow read: if isSignedIn() && (
        request.auth.uid == userId
        ||
        (
          resource.data.groupId != null
          && resource.data.groupId ==
            get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.groupId
        )
      );

      allow delete: if false;
    }

    match /groups/{groupId} {
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.admins
        && request.auth.uid in request.resource.data.memberIds;

      allow read: if isSignedIn()
        && request.auth.uid in resource.data.memberIds;

      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.admins
        ||
        (
          !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly(['memberIds'])
          && request.resource.data.memberIds.size()
              == resource.data.memberIds.size() + 1
        )
      );

      allow delete: if false;

      match /meals/{mealId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.userId in
            get(/databases/$(database)/documents/groups/$(groupId))
              .data.memberIds
          && (
            request.resource.data.userId == request.auth.uid
            || isGroupAdmin(groupId)
          );

        allow update: if isGroupMember(groupId)
          && request.resource.data.userId == resource.data.userId
          && (
            resource.data.userId == request.auth.uid
            || isGroupAdmin(groupId)
          );

        allow delete: if isGroupAdmin(groupId)
          || (
            isGroupMember(groupId)
            && resource.data.userId == request.auth.uid
          );
      }

      match /expenses/{expenseId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.paidById == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.date is timestamp;

        allow update: if isGroupMember(groupId)
          && request.resource.data.paidById == resource.data.paidById
          && (
            resource.data.paidById == request.auth.uid
            || isGroupAdmin(groupId)
          )
          && request.resource.data.name is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.date is timestamp
          && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'name',
                'amount',
                'date',
                'updatedBy',
                'updatedAt'
              ]);

        allow delete: if false;
      }
      match /monthlySettings/{monthKey} {
  allow read: if isGroupMember(groupId);

  allow create, update: if isGroupAdmin(groupId)
    && request.resource.data.minimumMeals is number
    && request.resource.data.minimumMeals >= 0
    && request.resource.data.monthKey == monthKey;

  allow delete: if false;
}
    }

    match /invites/{inviteCode} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }
  }
}